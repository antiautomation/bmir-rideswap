rules_version = '2';

// RETIRED — 2026-07-25.
//
// The v1 RideSwap board is no longer in service; ridefinder.site now points at
// the v2 app (see ../server, ../web). Until this file was replaced, the listing
// collections carried `allow read: if true`, which meant the entire 2025 board —
// 511 posts including 354 email addresses and 328 phone numbers — was readable
// by anyone who knew the project id, with no credentials of any kind. Verified
// with an unauthenticated GET against the Firestore REST API.
//
// The contact list has been exported into v2 (`invite_contacts`, via
// server/src/lib/legacyImport.ts), so nothing here is needed any more. Everything
// below is denied. That intentionally breaks the old app.
//
// If this data is ever needed again, either flip the rule temporarily or read it
// through the Firebase console / an admin SDK credential, both of which bypass
// rules entirely.
//
// Deploy from this directory (needs `firebase login` first):
//   firebase deploy --only firestore:rules --project bmir-rideshare

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
