# Copy to .env for local development (server reads process.env; use `node --env-file` or export)
DATABASE_URL=postgres://ridefinder:ridefinder@localhost:5433/ridefinder
PORT=3000
APP_ORIGIN=http://localhost:3000
NODE_ENV=development

# Amazon SES (leave EMAIL_DRY_RUN=1 until SES production access is granted)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
SES_FROM="RideFinder <matching@ridefinder.site>"
EMAIL_DRY_RUN=1

# Admin bootstrap: POST /api/admin/claim {key} with this value promotes your session to admin
ADMIN_KEY=change-me
